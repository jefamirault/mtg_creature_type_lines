# Copy to .env and fill in. .env is git-ignored; this template is committed.
# These describe the *server*, not site content — content is public anyway.

# Deploy target for ./deploy.sh (rsync over SSH).
DEPLOY_USER=deploy
DEPLOY_HOST=143.244.201.147
DEPLOY_PATH=/var/www/creature_type_combos
# Where it is served (nginx-mtg-creature_type_combos.conf maps it to DEPLOY_PATH). No trailing slash.
SITE_URL=https://mtg.jefamirault.com/creature_type_combos

# Port for ./local_server.sh (optional; a CLI arg overrides this).
LOCAL_PORT=8123
